# Copy to /etc/benin-watch/benin-watch.env  (owner root:root, mode 0600).
# Read by systemd itself, not by the service user. NEVER commit the real file.

# Required: exact ntfy.sh topic name (not the URL). Long and unpredictable.
NTFY_TOPIC=

# Optional: ntfy access token (tk_...) if the topic is reserved/protected.
#NTFY_TOKEN=

# Strongly recommended: dead-man switch ping URL (e.g. healthchecks.io check,
# period 2 min, grace 8 min). Secret: anyone with it can ping on your behalf.
HEALTHCHECK_URL=

# Optional tunables (defaults shown). Do NOT set BW_STATE_DIR here.
#BW_REMINDER_MINUTES=5,15,30,60
#BW_STALE_ALERT_SECONDS=600
#BW_DELIVERY_STALE_SECONDS=600
#BW_RUN_BUDGET=100
