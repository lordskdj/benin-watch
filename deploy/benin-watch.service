# One Benin Watch check. Started every ~2 minutes by benin-watch.timer.
# Install: see DEPLOY.md. Code: /opt/benin-watch (root-owned, read-only for the service).
# State: /var/lib/benin-watch (created by systemd, mode 0700, owned by benin-watch).
[Unit]
Description=Benin Watch - one availability check of voyage.benin.bj
Documentation=file:///opt/benin-watch/DEPLOY.md
Wants=network-online.target
After=network-online.target
# Timeout kill, signal or interpreter crash -> urgent self-alert + dead-man /fail.
OnFailure=benin-watch-failure.service
# Never stop retrying after repeated failures: the timer must keep firing forever.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=benin-watch
Group=benin-watch
WorkingDirectory=/opt/benin-watch
# -E: ignore PYTHON* variables, -s: no user site-packages, -B: no .pyc in /opt.
ExecStart=/usr/bin/python3 -E -s -B /opt/benin-watch/watcher.py
Environment=BW_STATE_DIR=/var/lib/benin-watch
Environment=BW_INSTANCE=VPS
Environment=PYTHONUNBUFFERED=1
# Secrets (NTFY_TOPIC, NTFY_TOKEN, HEALTHCHECK_URL): root-only file, read by systemd itself.
EnvironmentFile=/etc/benin-watch/benin-watch.env
# 0 = OK, 10 = degraded (site unreachable / alert not yet delivered: already reported
# through ntfy or the dead-man switch), 75 = another instance running.
# 3 = fatal (already self-alerted) is deliberately a failure: visible in systemctl.
SuccessExitStatus=10 75
# Internal budget: 100 s run + 10 s health ping (+ 15 s self-alert on fatal) < 150 s.
TimeoutStartSec=150
StateDirectory=benin-watch
StateDirectoryMode=0700
UMask=0077
SyslogIdentifier=benin-watch
MemoryMax=256M
TasksMax=32

# Hardening. The watcher only needs: outbound HTTPS (+ DNS), its state directory, the journal.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
